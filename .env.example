# Copy this file to .env.local and fill in the values (see README → "Account setup").
# .env.local is git-ignored. These are all browser-safe values — never put a
# Supabase service_role / secret key or a Cloudinary API secret here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudinary → Dashboard (cloud name) and Settings → Upload → Upload presets
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=saree_uploads
